@model List<WebApp.Models.CartItem>
@{
    ViewData["Title"] = "Order Checkout & Address Selection";
    var addresses = ViewBag.Addresses as List<WebApp.Models.AddressDto> ?? [];
    double total = Model.Sum(i => i.Price * i.Quantity);
}

<h1 style="font-size: 2rem; margin-bottom: 2rem; display: flex; align-items: center; gap: 0.5rem;">
    Order Checkout
</h1>

<div style="display: flex; gap: 2rem; flex-wrap: wrap;">
    

    <div style="flex: 1.5; min-width: 320px; display: flex; flex-direction: column; gap: 2rem;">
        
        <div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 16px; padding: 2rem; backdrop-filter: blur(10px);">
            <h2 style="font-size: 1.3rem; margin-bottom: 0.5rem; color: var(--accent-teal);">
                1. Select Shipping Address
            </h2>

            <form asp-controller="Orders" asp-action="PlaceOrder" method="post" id="placeOrderForm">
                @Html.AntiForgeryToken()

                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    @for (int i = 0; i < addresses.Count; i++)
                    {
                        var addr = addresses[i];
                        <label style="display: flex; padding: 1.25rem; border: 1px solid var(--border-color); border-radius: 10px; background: rgba(15, 23, 42, 0.4); cursor: pointer; transition: border-color 0.2s ease;">
                            <input type="radio" name="selectedAddressId" value="@addr.Id" @(i == 0 ? "checked=\"checked\"" : "") style="margin-right: 1rem; accent-color: var(--accent-emerald);" />
                            <div>
                                <strong style="color: var(--text-primary); font-family: var(--font-family-title);">@addr.AddressName</strong>
                                <p style="color: var(--text-muted); font-size: 0.9rem; margin-top: 0.25rem;">@addr.AddressLine</p>
                            </div>
                        </label>
                    }
                </div>

                <div style="margin-top: 2rem; display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border-color); padding-top: 1.5rem;">
                    <a href="@Url.Action("Cart", "Orders")" class="btn-secondary">
                        Back to Cart
                    </a>
                    
                    <button type="submit" class="btn-primary" style="padding: 0.8rem 2.5rem; font-size: 1.1rem;">
                        Confirm &amp; Place Order
                    </button>
                </div>
            </form>
        </div>

    </div>


    <div style="flex: 1; min-width: 300px;">
        <div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 16px; padding: 2rem; backdrop-filter: blur(10px); position: sticky; top: 100px;">
            <h2 style="font-size: 1.3rem; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.75rem;">
                Order Summary
            </h2>

            <div style="display: flex; flex-direction: column; gap: 1rem; max-height: 250px; overflow-y: auto; margin-bottom: 1.5rem;">
                @foreach (var item in Model)
                {
                    <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.95rem;">
                        <div>
                            <strong style="color: var(--text-primary);">@item.Name</strong>
                            <p style="color: var(--text-muted); font-size: 0.8rem;">Qty: @item.Quantity &times; $@item.Price.ToString("F2")</p>
                        </div>
                        <span style="font-weight: 600; color: var(--text-primary);">$@((item.Price * item.Quantity).ToString("F2"))</span>
                    </div>
                }
            </div>

            <div style="border-top: 2px dashed var(--border-color); padding-top: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 1.1rem; color: var(--text-muted); font-weight: 500;">Total Amount:</span>
                <span style="font-size: 1.6rem; color: var(--accent-emerald); font-weight: 800; font-family: var(--font-family-title);">$@total.ToString("F2")</span>
            </div>
        </div>
    </div>

</div>
