@model WebApp.Models.LoginRequest
@{
    ViewData["Title"] = "Customer Login";
}

<div class="auth-container">
    <div class="auth-header">
        <h2>Customer Portal Login</h2>
    </div>

    <form asp-controller="Account" asp-action="Login" method="post">
        @Html.AntiForgeryToken()
        @if (ViewBag.ReturnUrl != null)
        {
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
        }

        <div asp-validation-summary="ModelOnly" style="color: var(--error); margin-bottom: 1rem; font-size: 0.9rem; list-style: none;"></div>

        <div class="form-group" style="margin-bottom: 1.25rem;">
            <label for="Username">Username</label>
            <input asp-for="Username" class="form-control" placeholder="Enter your username..." required="required" autofocus="autofocus" />
            <span asp-validation-for="Username" style="color: var(--error); font-size: 0.8rem;"></span>
        </div>

        <div class="form-group" style="margin-bottom: 2rem;">
            <label for="Password">Password</label>
            <input asp-for="Password" type="password" class="form-control" placeholder="Enter your password..." required="required" />
            <span asp-validation-for="Password" style="color: var(--error); font-size: 0.8rem;"></span>
        </div>

        <button type="submit" class="btn-primary" style="width: 100%; padding: 0.8rem;">
            Log In Securely
        </button>
    </form>

    <div style="text-align: center; margin-top: 1.5rem; color: var(--text-muted); font-size: 0.9rem;">
        Don't have a customer account? <a asp-controller="Account" asp-action="Register" style="color: var(--accent-emerald); text-decoration: none; font-weight: 600;">Sign Up</a>
    </div>
</div>
